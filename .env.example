# Server runtime (protected; never expose in browser code)
SUPABASE_URL=https://pnoqggozzybcxfvwjmsr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-Manus-protected-secrets

# Browser-safe value retained only for legacy/local tooling
SUPABASE_ANON_KEY=your-anon-public-key

# Optional but recommended: signs admin sessions (falls back to the service key).
SESSION_SECRET=
# Optional: initial password for the first "admin" account (min 10 chars). Accounts still using
# a well-known default password are forced to choose a new one at first login.
ADMIN_INITIAL_PASSWORD=
