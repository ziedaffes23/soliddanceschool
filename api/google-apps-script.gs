function doPost(e) { try { var data = JSON.parse(e.postData.contents); var required = ['name','phone','email','age','class','level']; required.forEach(function(k){ if (!data[k]) throw new Error('Missing field: '+k); }); var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Registrations') || SpreadsheetApp.getActiveSpreadsheet().insertSheet('Registrations'); if (sheet.getLastRow() === 0) sheet.appendRow(['Timestamp','Full name','Phone','Email','Age','Class','Level','Trial','Message','Status']); sheet.appendRow([new Date(),data.name,data.phone,data.email,data.age,data.class,data.level,data.trial || 'no',data.message || '', 'New']); return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON); } catch (err) { return ContentService.createTextOutput(JSON.stringify({ok:false,error:err.message})).setMimeType(ContentService.MimeType.JSON); } }